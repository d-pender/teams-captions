<!-- Teams Captions main window. Loaded at run time by App.cs (no code-behind); named
     elements are looked up with FindName. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teams Captions" Width="460" Height="560" MinWidth="360" MinHeight="380"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="#F5F5F7" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DADCE0"/>
      <Setter Property="Foreground" Value="#1F1F1F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#F1F3F4"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#E8EAED"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3E44A6"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#9AA0A6"/>
                <Setter TargetName="Chrome" Property="Background" Value="#F5F5F7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0,3,10,0" Fill="#9E9E9E" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" FontSize="19" FontWeight="SemiBold" Foreground="#1F1F1F"
                 Text="Waiting for live captions" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <TextBlock x:Name="DetailText" Grid.Row="1" Margin="22,4,0,14" Foreground="#5F6368" TextWrapping="Wrap"/>

    <Border Grid.Row="2" Background="White" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="6">
      <Grid>
        <ScrollViewer x:Name="LinesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="LinesPanel" Margin="14,12,14,4"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyHint" Margin="28" Foreground="#80868B" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Captions show up here as they are saved."/>
      </Grid>
    </Border>

    <WrapPanel Grid.Row="3" Margin="0,14,0,0">
      <Button x:Name="StartStopButton" Content="Stop"/>
      <Button x:Name="OpenFileButton" Content="Open transcript"/>
      <Button x:Name="OpenFolderButton" Content="Open folder"/>
    </WrapPanel>

    <StackPanel Grid.Row="4" Margin="0,16,0,0">
      <DockPanel>
        <Button x:Name="ChangeFolderButton" DockPanel.Dock="Right" Content="Change..." Margin="8,0,0,0" MinWidth="0" Padding="10,3"/>
        <TextBlock Text="Saves to  " Foreground="#5F6368" VerticalAlignment="Center"/>
        <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <CheckBox x:Name="SignInCheck" Margin="0,10,0,0" Foreground="#3C4043"
                Content="Start when I sign in, in the notification area"/>
    </StackPanel>
  </Grid>
</Window>
